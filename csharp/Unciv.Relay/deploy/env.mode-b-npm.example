# Mode B (the relay holds the certificate) reading Nginx Proxy Manager's Let's Encrypt certificate through a read-only mount (T356).
# This is the shape of the deployment on civsharp.nickthorsen.com:47830 (the project owner's relay). The owner's real .env was not committed or shown to the
# repository; this file is the documented equivalent. Use it as: cp env.mode-b-npm.example .env   then edit the three marked lines   then docker compose up -d --build
# Everything not listed here keeps the relay default (empty value = default), exactly as in .env.example; compose.yml needs no change.

# Publish the tunnel on the public port. The HTTP side stays on loopback (healthz and /v1/info are reached from the server itself, or through your own proxy).
RELAY_TUNNEL_PUBLISH=0.0.0.0:47830
RELAY_HTTP_PUBLISH=127.0.0.1:47831

# EDIT: the host directory that is NPM's letsencrypt folder (the one holding live/ AND archive/; the files in live/ are symlinks into archive/, so
# mount the parent, not a single live/npm-N folder). compose.yml mounts it read-only at /certs. Example for a default NPM install: /home/you/npm/letsencrypt
RELAY_CERT_DIR=/path/to/nginx-proxy-manager/letsencrypt

# Mode B: no TLS-none, no PROXY protocol, no self-signed certificate.
UNCIV_RELAY_TLS=
# EDIT: npm-N is the certificate id NPM gave your certificate (ls RELAY_CERT_DIR/live). Paths are INSIDE the container.
UNCIV_RELAY_CERT=/certs/live/npm-N/fullchain.pem
UNCIV_RELAY_KEY=/certs/live/npm-N/privkey.pem
UNCIV_RELAY_SELF_SIGNED=
UNCIV_RELAY_PROXY_PROTOCOL=
UNCIV_RELAY_TRUSTED_PROXY=
# The name hosts sign and players type. Empty = the certificate's names (a *.nickthorsen.com wildcard needs it spelled out).
UNCIV_RELAY_PUBLIC_NAME=civsharp.nickthorsen.com

# The abuse contact /v1/info shows.
UNCIV_RELAY_CONTACT=me@nickthorsen.com

# Log files in the data volume are deleted after 7 days (the relay default, spelled out so it is visible); stdout is kept by the container runtime: docker compose logs relay
UNCIV_RELAY_LOG_RETENTION_DAYS=7
